# ─── Deployer ────────────────────────────────────────────────────────────────
PRIVATE_KEY=0x_your_deployer_private_key

# ─── RPC ─────────────────────────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# ─── Verification (Etherscan V2 — one key, all chains incl. Base) ─────────────
# Get a key at https://etherscan.io/myapikey. A single V2 key verifies on Base,
# Base Sepolia, Arbitrum, OP, etc. via api.etherscan.io/v2. Preferred.
ETHERSCAN_API_KEY=your_etherscan_v2_key
# Legacy per-explorer Basescan key — only used as a fallback if ETHERSCAN_API_KEY
# is unset (deprecated V1 path).
BASESCAN_API_KEY=your_basescan_key

# ─── Factory deploy (scripts/deploy.ts) ──────────────────────────────────────
# NETWORK_MODE: 0 = Base Mainnet, 1 = Base Sepolia (default)
NETWORK_MODE=1

# Arbitrator wallet (defaults to deployer if omitted).
DEFAULT_ARBITRATOR=0xYourArbitratorAddress

# Protocol fee wallet — set to 0x0000…0000 to disable all fees.
FEE_COLLECTOR=0xFA4269275689EbFFE9299c0EE106C37a709B164B

# Compliance officer — releases or forfeits the 3% seller consolation
# held in-contract after a disputed buyer-award refund.
COMPLIANCE_OFFICER=0x33c4223319015BFDb38CA144d8cE201ecd482871

# Fee schedule (basis points; 100 bps = 1%).
DEPOSIT_FEE_BPS=290          # 2.90% on funding
SETTLE_FEE_BPS=190           # 1.90% on release to seller
DEADLINE_REFUND_FEE_BPS=300  # 3.00% on seller-no-show refund
DISPUTE_REFUND_FEE_BPS=900   # 9.00% on disputed buyer-award refund
SELLER_CONSOLATION_BPS=300   # 3.00% redirected to seller (held pending compliance)

# Optional: Chainlink Functions verifier address (leave blank on first deploy,
# then redeploy the factory with this set after deploy-verifier.ts).
DEFAULT_VERIFIER=0x0000000000000000000000000000000000000000

# Optional: USDC token override. 0x0 = canonical Circle USDC for the network.
# Set to a mock-USDC address (from scripts/deploy-mock-usdc.ts) for easy,
# mintable USDC on testnet smoke tests.
USDC=0x0000000000000000000000000000000000000000

# ─── Verifier deploy (scripts/deploy-verifier.ts) ────────────────────────────
# Base Sepolia Chainlink Functions:
ROUTER=0xf9B8fc078197181C841c296C876945aaa425B278
DON_ID=0x66756e2d626173652d7365706f6c69612d310000000000000000000000000000
SUB_ID=

# ─── Subname registrar deploy (Foundry: DeployMettaPaySubnameRegistrar.s.sol) ─
# Used by `forge script ... --sig "runSepolia()"`. USDC + ETH/USD feed are
# pinned in the script for Base Sepolia, so you only set these:
DURIN_L2_REGISTRY=0x_durin_l2_registry_on_base_sepolia
TREASURY=0x_treasury_multisig            # receives registrar withdraw()
BACKEND_SIGNER=0x_backend_eoa            # mints the free 0x{first5} handles
# REGISTRAR=0x...                        # set after deploy, for the Quote smoke test

# ─── Reference (no need to set) ──────────────────────────────────────────────
# Base Sepolia USDC:        0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base Mainnet USDC:        0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# ETH/USD feed (Sepolia):   0x4aDC67696bA383F43DD60A9e78F2C97Fbbfc7cb1
# USDC/USD feed (Sepolia):  0xd30e2101a97dcbAeBCBC04F14C3f624E67A35165
